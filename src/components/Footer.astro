---
import ToskiWordmark from './brand/ToskiWordmark.astro';
import { getLang, href, LAB_URL, PETHEALTH_URL, useTranslations } from '../i18n/ui';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const linkClass = 'inline-flex min-h-11 items-center text-[15px] text-footer-ink no-underline hover:text-caramelo';
const titleClass = 'mb-1.5 text-[13px] font-semibold uppercase tracking-[0.06em] text-footer-muted';
---

<footer class="relative bg-footer text-footer-ink">
  <!-- No celular sobra espaço embaixo para o botão "Voltar ao topo" não cobrir o texto. -->
  <div class="page flex flex-col gap-10 pt-14 pb-24 md:pb-10">
    <div class="flex flex-wrap justify-between gap-8">
      <div class="flex max-w-80 flex-col gap-2.5">
        <a href={LAB_URL[lang]} class="text-2xl text-footer-ink no-underline hover:text-footer-ink"><ToskiWordmark /></a>
        <p class="text-[15px] leading-normal text-footer-muted">{t('footer.lab')}</p>
      </div>
      <div class="flex flex-wrap gap-12">
        <nav aria-labelledby="rodape-projetos" class="flex flex-col gap-1">
          <p id="rodape-projetos" class={titleClass}>{t('footer.projects')}</p>
          <a href={PETHEALTH_URL[lang]} class={linkClass}>PetHealthTracker</a>
          <a href={href(lang, 'app')} aria-current="page" class={linkClass}>Koti</a>
        </nav>
        <nav aria-labelledby="rodape-ajuda" class="flex flex-col gap-1">
          <p id="rodape-ajuda" class={titleClass}>{t('footer.help')}</p>
          <a href={href(lang, 'support')} class={linkClass}>{t('nav.support')}</a>
          <a href={href(lang, 'privacy')} class={linkClass}>{t('nav.privacy')}</a>
        </nav>
      </div>
    </div>
    <div class="flex flex-col gap-1 border-t border-footer-line pt-6 text-sm text-footer-muted sm:flex-row sm:flex-wrap sm:justify-between sm:gap-2">
      <span>© {new Date().getFullYear()} Toski Labs</span>
      <span>{t('footer.place')}</span>
    </div>
  </div>
  <!-- Voltar ao topo: só no celular, âncora simples (sem JavaScript). -->
  <a
    href="#top"
    class="absolute right-4 bottom-4 flex size-12 items-center justify-center rounded-full bg-accent text-on-accent shadow-[0_10px_28px_rgba(0,0,0,0.28)] ring-2 ring-footer hover:bg-accent-hover hover:text-on-accent md:hidden"
  >
    <span class="sr-only">{t('toTop')}</span>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"></path></svg>
  </a>
</footer>
