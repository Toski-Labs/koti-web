---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PrivacyPage from '../../components/pages/PrivacyPage.astro';
import { seo } from '../../data/seo';
import { routes } from '../../i18n/ui';
import { breadcrumb } from '../../lib/schema';

const { title, description } = seo.en.privacy;
const url = new URL(routes.en.privacy, Astro.site).href;
---

<BaseLayout page="privacy" title={title} description={description} graph={[breadcrumb(Astro.site!, routes.en.app, 'Privacy Policy', url)]}>
  <PrivacyPage />
</BaseLayout>
