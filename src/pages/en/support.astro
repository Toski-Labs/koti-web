---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SupportPage from '../../components/pages/SupportPage.astro';
import { seo } from '../../data/seo';
import { routes } from '../../i18n/ui';
import { breadcrumb, faqPage } from '../../lib/schema';

const { title, description } = seo.en.support;
const url = new URL(routes.en.support, Astro.site).href;
---

<BaseLayout page="support" title={title} description={description} graph={[breadcrumb(Astro.site!, routes.en.app, 'Support', url), faqPage('en', url)]}>
  <SupportPage />
</BaseLayout>
